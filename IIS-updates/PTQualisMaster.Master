<body class="theme-red ls-closed">
    <form id="form1" runat="server">
        <!-- Page Loader -->
        <div class="page-loader-wrapper">
            <div class="loader">
                <div class="preloader">
                    <div class="spinner-layer pl-red">
                        <div class="circle-clipper left">
                            <div class="circle"></div>
                        </div>
                        <div class="circle-clipper right">
                            <div class="circle"></div>
                        </div>
                    </div>
                </div>
                <p>Please wait...</p>
            </div>
        </div>
        <!-- #END# Page Loader -->
        <!-- Overlay For Sidebars -->
        <div class="overlay"></div>
        <!-- #END# Overlay For Sidebars -->
        <!-- Search Bar -->
        <div class="search-bar">
            <div class="search-icon">
                <i class="material-icons">search</i>
            </div>
            <input type="text" placeholder="START TYPING...">
            <div class="close-search">
                <i class="material-icons">close</i>
            </div>
        </div>
        <!-- #END# Search Bar -->
        <!-- Top Bar -->

        <section>

            <!-- Left Sidebar -->
            <aside id="leftsidebar" class="sidebar">
                <!-- User Info -->
                <div class="user-info">
                    <div>
                        <table>
                            <tr>
                                <td>
                                    <img src="assets/img/qualis.png" width="auto" height="70" alt="User" />
                                    <%--<img src="assets/img/logo9.png" width="auto" height="70" alt="User" />--%>
                                </td>
                                <td>
                                    <h1 style="color: white;" cssclass="trajan-text">ERP</h1>
                                </td>
                            </tr>
                        </table>

                    </div>
                    <div class="info-container">
                        <div class="name" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <asp:Label ID="lblUserName" runat="server"></asp:Label>
                        </div>
                        <div class="email">
                            <asp:Label ID="lblUserEmail" runat="server"></asp:Label>
                        </div>


                        <div class="btn-group user-helper-dropdown">
                            <i class="material-icons" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">keyboard_arrow_down</i>
                            <ul class="dropdown-menu pull-right">
                                <li><a href="EmployeeProfile.aspx"><i class="material-icons">person</i>Profile</a></li>
                                <li role="separator" class="divider"></li>
                                <li><a href="javascript:void(0);"><i class="material-icons">group</i>Supervisors</a></li>
                                <li><a href="WorkList.aspx"><i class="material-icons">business_center</i>WorkList</a></li>
                                <li role="separator" class="divider"></li>
                                <li><a href="Login.aspx"><i class="material-icons">input</i>Sign Out</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <!-- #User Info -->

                <asp:Repeater ID="DynamicMenuRepeater" runat="server">
                    <HeaderTemplate>
                        <div class="menu">
                            <ul class="list">
                                <li class="header">MAIN NAVIGATION</li>
                    </HeaderTemplate>
                    <ItemTemplate>
                        <li class='<%# IsCurrentPage(Eval("Url").ToString()) ? "active" : HasActiveChild(Eval("SubItems") as List<LIMS.Models.MenuItem>) ? "active" : "" %>'>
                            <!-- For menu items without children -->
                            <asp:Panel runat="server" Visible='<%# ((List<LIMS.Models.MenuItem>)Eval("SubItems")).Count == 0 %>'>
                                <a href='<%# Eval("Url") %>' target='<%# Convert.ToBoolean(Eval("OpenInNewTab")) ? "_blank" : "_self" %>'>
                                    <i class='material-icons <%# Eval("IconClassName") %>' style="font-size: 20px;"></i>
                                    <span><%# Eval("Title") %></span>
                                </a>
                            </asp:Panel>

                            <!-- For menu items with children -->
                            <asp:Panel runat="server" Visible='<%# ((List<LIMS.Models.MenuItem>)Eval("SubItems")).Count > 0 %>'>
                                <a href="javascript:void(0);" class='menu-toggle <%# HasActiveChild(Eval("SubItems") as List<LIMS.Models.MenuItem>) ? "toggled" : "" %>' target='<%# Convert.ToBoolean(Eval("OpenInNewTab")) ? "_blank" : "_self" %>'>
                                    <i class='material-icons <%# Eval("IconClassName") %>' style="font-size: 20px;"></i>
                                    <span><%# Eval("Title") %></span>
                                </a>
                                <ul class="ml-menu" style='<%# HasActiveChild(Eval("SubItems") as List<LIMS.Models.MenuItem>) ? "display: block;": "" %>'>
                                    <asp:Repeater ID="SubMenuRepeater" runat="server" DataSource='<%# Eval("SubItems") %>'>
                                        <ItemTemplate>
                                            <li class='<%# IsCurrentPage(Eval("Url").ToString()) ? "active" : "" %>'>
                                                <!-- For sub-menu items without children -->
                                                <asp:Panel runat="server" Visible='<%# ((List<LIMS.Models.MenuItem>)Eval("SubItems")).Count == 0 %>'>
                                                    <a href='<%# Eval("Url") %>' target='<%# Convert.ToBoolean(Eval("OpenInNewTab")) ? "_blank" : "_self" %>'>
                                                        <i class='material-icons <%# Eval("IconClassName") %>' style="font-size: 15px;"></i>
                                                        <span><%# Eval("Title") %></span>
                                                    </a>
                                                </asp:Panel>

                                                <!-- For sub-menu items with children -->
                                                <asp:Panel runat="server" Visible='<%# ((List<LIMS.Models.MenuItem>)Eval("SubItems")).Count > 0 %>'>
                                                    <a href="javascript:void(0);" class='menu-toggle <%# HasActiveChild(Eval("SubItems") as List<LIMS.Models.MenuItem>) ? "toggled" : "" %>' target='<%# Convert.ToBoolean(Eval("OpenInNewTab")) ? "_blank" : "_self" %>'>
                                                        <span><%# Eval("Title") %></span>
                                                    </a>
                                                    <ul class="ml-menu" style='<%# HasActiveChild(Eval("SubItems") as List<LIMS.Models.MenuItem>) ? "display: block;": "" %>'>
                                                        <asp:Repeater ID="SubSubMenuRepeater" runat="server" DataSource='<%# Eval("SubItems") %>'>
                                                            <ItemTemplate>
                                                                <li class='<%# IsCurrentPage(Eval("Url").ToString()) ? "active" : "" %>'>
                                                                    <a href='<%# Eval("Url") %>' target='<%# Convert.ToBoolean(Eval("OpenInNewTab")) ? "_blank" : "_self" %>'>
                                                                        <i class='material-icons <%# Eval("IconClassName") %>' style="font-size: 15px;"></i>
                                                                        <span><%# Eval("Title") %></span>
                                                                    </a>
                                                                </li>
                                                            </ItemTemplate>
                                                        </asp:Repeater>
                                                    </ul>
                                                </asp:Panel>
                                            </li>
                                        </ItemTemplate>
                                    </asp:Repeater>
                                </ul>
                            </asp:Panel>
                        </li>
                    </ItemTemplate>
                    <FooterTemplate>
                        </ul>
        </div>
                    </FooterTemplate>
                </asp:Repeater>

            </aside>



            <!-- #END# Left Sidebar -->
            <!-- Right Sidebar -->
            <aside id="rightsidebar" class="right-sidebar">
